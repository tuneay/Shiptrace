# GitHub REST API (recommended; raises the public API rate limit)
GITHUB_TOKEN=

# Groq Responses API (recommended; deterministic fallback is used when omitted)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase (required in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public deployment origin, without a trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000
